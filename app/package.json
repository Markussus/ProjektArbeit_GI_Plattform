{
  "name": "projektarbeit_gi_plattform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open --port 4173",
    "prepare:java-compiler": "node scripts/prepare-teavm-javac.mjs",
    "build:app": "tsc -b && vite build",
    "build": "npm run prepare:java-compiler && npm run build:app",
    "release": "node ../Deployment/create-release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pre:commit:check": "npm run lint && npm run format:check && npm run build:preview:open",
    "pre:commit:cleanup": "npm run lhci:config && npm run format && npm run lint:fix",
    "fix": "npm run lint:fix && npm run format",
    "preview": "vite preview",
    "build:preview:open": "npm run prepare:java-compiler && npm run build:app && vite preview --open",
    "e2e-test": "npm run build:app && playwright test",
    "e2e-test:open": "playwright test --ui",
    "e2e-test:report": "playwright show-report",
    "preview:ci": "vite preview --host 127.0.0.1 --strictPort",
    "lhci:config": "node scripts/sync-lighthouserc-from-module-catalog.mjs",
    "lighthouse:ci": "lhci autorun",
    "lhci": "npm run build && node scripts/run-preview-command.mjs --task=lhci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit",
    "verify:signatures": "npm audit signatures",
    "lhci:ci": "node scripts/run-preview-command.mjs --task=lhci",
    "e2e:ci": "node scripts/run-preview-command.mjs --task=e2e",
    "pipeline:local": "node scripts/pipeline-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "java-parser": "^3.0.1",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.13.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/mcp": "0.0.70",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "archiver": "8.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fallow": "2.89.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "@puppeteer/browsers": "^3.2.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
