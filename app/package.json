{
  "name": "projektarbeit_gi_plattform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pre:commit:check": "npm run lint && npm run format:check && npm run build:preview:open",
    "pre:commit:cleanup": "npm run lhci:config && npm run format && npm run lint:fix",
    "fix": "npm run lint:fix && npm run format",
    "preview": "vite preview",
    "build:preview:open": "tsc -b && vite build && vite preview --open",
    "e2e-test": "playwright test",
    "e2e-tesjt:open": "playwright test --ui",
    "e2e-test:report": "playwright show-report",
    "preview:ci": "vite preview --host 127.0.0.1 --strictPort",
    "lhci:config": "node scripts/sync-lighthouserc-from-module-catalog.mjs",
    "lighthouse:ci": "lhci autorun",
    "lhci": "npm run build && node scripts/run-preview-command.mjs --task=lhci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lhci:ci": "node scripts/run-preview-command.mjs --task=lhci",
    "e2e:ci": "node scripts/run-preview-command.mjs --task=e2e",
    "pipeline:local": "node scripts/pipeline-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "java-parser": "^3.0.1",
    "lucide-react": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "react-router-dom": "^7.13.2",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/mcp": "^0.0.70",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^3.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.4"
  }
}
