{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/info",
        "http://127.0.0.1:4173/__lhci-not-found__"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --user-data-dir=./.lighthouseci/chrome-profile"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1250
          }
        ]
      }
    }
  }
}
