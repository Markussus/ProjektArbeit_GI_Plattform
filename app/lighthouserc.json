{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 1000 }]
      }
    }
  }
}
