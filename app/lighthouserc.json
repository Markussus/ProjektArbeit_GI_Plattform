{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/documentation",
        "http://localhost:4173/help",
        "http://localhost:4173/__lhci-not-found__",
        "http://localhost:4173/fundamentals-cs",
        "http://localhost:4173/fundamentals-cs/turing-machine",
        "http://localhost:4173/fundamentals-cs/finite-automata",
        "http://localhost:4173/fundamentals-cs/number-systems",
        "http://localhost:4173/fundamentals-cs/moore-mealy",
        "http://localhost:4173/fundamentals-cs/dnf",
        "http://localhost:4173/programming-1",
        "http://localhost:4173/programming-1/java-programming"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --user-data-dir=./.lighthouseci/chrome-profile"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1000
          }
        ]
      }
    }
  }
}
