{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "ignoreDependencies": ["archiver"],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "health": {
    "ignore": [
      // programCommon.ts: 76 LOC, encapsulates stateless mathematical primitives for automata (bit calculations, alphabet checks).
      // splitting would cause artificial fragmentation.
      "src/pages/FundamentalsCS/MooreMealy/components/Simulator/domain/programCommon.ts",
      // mealyProgram.ts: 142 LOC, encapsulates invariants, validation, and normalization for the Mealy aggregate.
      "src/pages/FundamentalsCS/MooreMealy/components/Simulator/domain/mealyProgram.ts"
    ]
  }
}
